# Copy to .env.local and fill in from Supabase → Settings → API.
# NEVER put real keys in this file: it is committed to the repository.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The service_role key bypasses every row-level security policy. It must never
# be built into the browser bundle and must never be committed. Set it only if
# you know why you need it, and never in the Cloudflare Pages build settings.
VITE_SUPABASE_SERVICE_ROLE_KEY=
